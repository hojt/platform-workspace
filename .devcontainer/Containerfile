ARG USERNAME=developer
ARG BASE_IMAGE=registry.fedoraproject.org/fedora:43@sha256:c45b30a84cf2fb151e3d8f8683707ce42356f674357f10951b4dd71014a502f3

FROM ${BASE_IMAGE} AS base

ARG KIND_VERSION=0.32.0
# Update together with KIND_VERSION (kind-linux-amd64.sha256sum in the release)
ARG KIND_SHA256=50030de23cf40a18505f20426f6a8506bedf13c6e509244bd1fa9463721b0f54
ARG KUBECTL_VERSION=1.35.0
# Update together with KUBECTL_VERSION (kubectl.sha256 next to the binary)
ARG KUBECTL_SHA256=a2e984a18a0c063279d692533031c1eff93a262afcc0afdc517375432d060989
ARG TASK_VERSION=3.54.0
# Update together with TASK_VERSION (from task_checksums.txt in the release)
ARG TASK_SHA256=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb

ARG USERNAME
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd \
        --uid "${USER_UID}" \
        --gid "${USER_GID}" \
        --create-home \
        --shell /bin/bash \
        "${USERNAME}"

RUN mkdir -p \
      "/home/${USERNAME}/.config/nvim" \
      "/home/${USERNAME}/.kube" \
      "/home/${USERNAME}/.local/share/nvim" \
      "/home/${USERNAME}/.local/state/nvim" \
      "/home/${USERNAME}/.cache/nvim" \
    && chown -R "${USERNAME}:${USERNAME}" \
      "/home/${USERNAME}/.config" \
      "/home/${USERNAME}/.kube" \
      "/home/${USERNAME}/.local" \
      "/home/${USERNAME}/.cache"

RUN dnf install -y \
        bash \
        ca-certificates \
        curl \
        fd-find \
        findutils \
        fzf \
        git \
        neovim \
        procps-ng \
        ripgrep \
        shellcheck \
        tar \
        tree \
        unzip \
    && dnf clean all

# Task
RUN curl --fail --location --silent --show-error \
        "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_amd64.tar.gz" \
        --output /tmp/task.tar.gz \
    && echo "${TASK_SHA256}  /tmp/task.tar.gz" | sha256sum --check --strict \
    && tar --extract \
        --gzip \
        --file /tmp/task.tar.gz \
        --directory /usr/local/bin \
        task \
    && rm /tmp/task.tar.gz \
    && task --version

# kind
RUN curl --fail --location --silent --show-error \
        "https://kind.sigs.k8s.io/dl/v${KIND_VERSION}/kind-linux-amd64" \
        --output /usr/local/bin/kind \
    && echo "${KIND_SHA256}  /usr/local/bin/kind" | sha256sum --check --strict \
    && chmod +x /usr/local/bin/kind \
    && kind version

# kubectl
RUN curl --fail --location --silent --show-error \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        --output /usr/local/bin/kubectl \
    && echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum --check --strict \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client

WORKDIR /workspaces

USER ${USERNAME}


FROM base AS agent

ARG USERNAME

USER root

ARG OPENCODE_VERSION=1.18.34
# Update together with OPENCODE_VERSION
ARG OPENCODE_SHA256=0f22479647226d1d2dd99595d20082ee7bda3870b62dc6a90b41efc1a71d7e9a

ARG CLAUDE_CODE_VERSION=2.1.302

RUN mkdir -p \
        /home/${USERNAME}/.local/share/opencode \
        /home/${USERNAME}/.claude \
    && chown -R ${USERNAME}:${USERNAME} \
        /home/${USERNAME}/.local/share/opencode \
        /home/${USERNAME}/.claude

RUN curl --fail --location --silent --show-error \
    "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" \
    --output /tmp/opencode.tar.gz \
    && echo "${OPENCODE_SHA256}  /tmp/opencode.tar.gz" | sha256sum --check --strict \
    && tar --extract \
        --gzip \
        --file /tmp/opencode.tar.gz \
        --directory /tmp \
    && install --mode=0755 /tmp/opencode /usr/local/bin/opencode \
    && rm /tmp/opencode.tar.gz /tmp/opencode \
    && opencode --version

RUN dnf install -y \
        nodejs24 \
        nodejs24-npm \
    && dnf clean all

RUN ln --symbolic /usr/bin/node-24 /usr/local/bin/node \
    && ln --symbolic /usr/bin/npm-24 /usr/local/bin/npm \
    && ln --symbolic /usr/bin/npx-24 /usr/local/bin/npx \
    && node --version \
    && npm --version \
    && npx --version

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

COPY .devcontainer/agent/claude-managed-settings.json /etc/claude-code/managed-settings.json

USER ${USERNAME}


FROM base AS development

ARG USERNAME

USER root

RUN dnf install -y \
        podman \
    && dnf clean all

USER ${USERNAME}
