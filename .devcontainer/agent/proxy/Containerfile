ARG BASE_IMAGE=registry.fedoraproject.org/fedora:43@sha256:a60334b24af6818e9ccf199d188b5ddef1c3d7f549470b560d9b744c78c2c58b

FROM ${BASE_IMAGE}

RUN dnf install -y tinyproxy \
    && dnf clean all

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf

USER nobody

EXPOSE 8888

ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
