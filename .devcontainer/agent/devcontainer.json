{
  "name": "${localWorkspaceFolderBasename}-agent",
  "build": {
    "dockerfile": "../Containerfile",
    "context": "../..",
    "target": "agent"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,readonly,relabel=shared",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}/.local/share/opencode/auth.json,target=/home/developer/.local/share/opencode/auth.json,type=bind,relabel=shared",
    // Platform repositories are read-only
    "source=${localWorkspaceFolder}/../homelab,target=/workspaces/${localWorkspaceFolderBasename}/repos/homelab,type=bind,readonly,relabel=shared",
    "source=${localWorkspaceFolder}/../local-platform,target=/workspaces/${localWorkspaceFolderBasename}/repos/local-platform,type=bind,readonly,relabel=shared",
    "source=${localWorkspaceFolder}/../local-environments,target=/workspaces/${localWorkspaceFolderBasename}/repos/local-environments,type=bind,readonly,relabel=shared",
    // Explicitly writable
    "source=${localWorkspaceFolder}/../homelab/docs,target=/workspaces/${localWorkspaceFolderBasename}/repos/homelab/docs,type=bind",
    // Hidden from the agent
    "target=/workspaces/${localWorkspaceFolderBasename}/repos/local-platform/.local,type=tmpfs,notmpcopyup",
    "target=/workspaces/${localWorkspaceFolderBasename}/repos/local-environments/.local,type=tmpfs,notmpcopyup",
    // Agent-only state
    "target=/workspaces/${localWorkspaceFolderBasename}/.opencode,type=tmpfs,notmpcopyup"
  ],
  "runArgs": [
    "--network=${localWorkspaceFolderBasename}-agent",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--memory=16g",
    "--cpus=8",
    "--pids-limit=2048"
  ],
  "remoteUser": "developer",
  "containerUser": "developer",
  "containerEnv": {
    "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "1",
    "HTTP_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "HTTPS_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "http_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "https_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1"
  },
  "updateRemoteUserUID": true
}
