{
  "name": "platform-workspace-agent",
  "build": {
    "dockerfile": "../Containerfile",
    "context": "../..",
    "target": "agent"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,relabel=shared",
  "mounts": [
    "source=${localEnv:HOME}/.local/share/opencode/auth.json,target=/home/developer/.local/share/opencode/auth.json,type=bind,relabel=shared",
    // Run or interpreted on the host
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspaces/${localWorkspaceFolderBasename}/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/agent.sh,target=/workspaces/${localWorkspaceFolderBasename}/agent.sh,type=bind,readonly",
    "source=${localWorkspaceFolder}/dev.sh,target=/workspaces/${localWorkspaceFolderBasename}/dev.sh,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git,target=/workspaces/${localWorkspaceFolderBasename}/.git,type=bind,readonly",
    // Run in dev-container (with access to podman-socket)
    "source=${localWorkspaceFolder}/Taskfile.yml,target=/workspaces/${localWorkspaceFolderBasename}/Taskfile.yml,type=bind,readonly",
    "source=${localWorkspaceFolder}/scripts,target=/workspaces/${localWorkspaceFolderBasename}/scripts,type=bind,readonly",
    // Agent configuration
    "source=${localWorkspaceFolder}/AGENTS.md,target=/workspaces/${localWorkspaceFolderBasename}/AGENTS.md,type=bind,readonly",
    "source=${localWorkspaceFolder}/opencode.json,target=/workspaces/${localWorkspaceFolderBasename}/opencode.json,type=bind,readonly",
    "target=/workspaces/${localWorkspaceFolderBasename}/.opencode,type=tmpfs",
    // Agent-only caches and build output
    "source=example-app-agent-maven-cache,target=/home/developer/.m2,type=volume",
    "source=example-app-agent-npm-cache,target=/home/developer/.npm,type=volume",
    "source=example-app-agent-frontend-node-modules,target=/workspaces/${localWorkspaceFolderBasename}/components/example-frontend/node_modules,type=volume",
    "source=example-app-agent-frontend-dist,target=/workspaces/${localWorkspaceFolderBasename}/components/example-frontend/dist,type=volume",
    "source=example-app-agent-backend-target,target=/workspaces/${localWorkspaceFolderBasename}/components/example-backend/target,type=volume"
  ],
  "runArgs": [
    "--network=${localWorkspaceFolderBasename}-agent",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--memory=16g",
    "--cpus=8",
    "--pids-limit=2048"
  ],
  "remoteUser": "developer",
  "containerUser": "developer",
  "containerEnv": {
    "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "1",
    "HTTP_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "HTTPS_PROXY": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "http_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "https_proxy": "http://${localWorkspaceFolderBasename}-agent-proxy:8888",
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1",
    "NODE_USE_ENV_PROXY": "1",
    "AGENT_PROXY_HOST": "${localWorkspaceFolderBasename}-agent-proxy",
    "MAVEN_ARGS": "--global-settings /workspaces/${localWorkspaceFolderBasename}/.devcontainer/agent/maven-settings.xml"
  },
  "updateRemoteUserUID": true
}
