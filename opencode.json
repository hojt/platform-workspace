{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "edit": {
      "*": "allow",
      ".opencode/**": "deny"
    },
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow"
    }
  }
}
